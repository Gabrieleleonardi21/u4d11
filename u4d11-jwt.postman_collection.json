              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "description": "Stessa email di 'Login' ma password sbagliata.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mario.rossi@example.com\",\n  \"password\": \"passwordSbagliata1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
