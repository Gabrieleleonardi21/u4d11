          "request": {
            "description": "Ogni utente aggiorna solo il proprio profilo: nessun id nel path, l'utente si ricava dal token.",
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mario Aggiornato\",\n  \"cognome\": \"Rossi\",\n  \"email\": \"mario.rossi@example.com\",\n  \"password\": \"password1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Aggiorna utente (solo ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "description": "Richiede ruolo ADMIN (promuovere l'utente loggato via SQL prima di eseguire questa richiesta): un utente USER riceve 403.",
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mario Aggiornato\",\n  \"cognome\": \"Rossi\",\n  \"email\": \"mario.rossi@example.com\",\n  \"password\": \"password1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Elimina il mio profilo (DELETE /me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 204', function () { pm.response.to.have.status(204); });"]
              }
            }
          ],
          "request": {
            "description": "Eseguire DOPO aver eliminato i propri blog post (foreign key). Nessun id nel path: elimina sempre l'utente del token.",
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Elimina utente per id (solo ADMIN, per ultimo!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 204', function () { pm.response.to.have.status(204); });"]
              }
            }
          ],
          "request": {
            "description": "Richiede ruolo ADMIN: un utente USER riceve 403. Eseguire DOPO aver eliminato i suoi blog post: se l'utente ha ancora post risponde 409 (foreign key).",
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        }
      ]
    },
