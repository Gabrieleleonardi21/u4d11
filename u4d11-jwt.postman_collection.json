            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/11111111-1111-1111-1111-111111111111",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "11111111-1111-1111-1111-111111111111"]
            }
          }
